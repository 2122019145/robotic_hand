// H 最快速度限制
const int FASTEST = 20;


// L 最慢速度限制
const int SLOWEST = 150;


// ============================================================
//                    10. 四个舵机独立计时
// ============================================================

// 以前你的代码四个舵机共用一个 lastMoveTime。
// 这样会造成四个舵机互相影响。
//
// 现在每个舵机都有自己的计时器。

unsigned long lastBaseMove = 0;
unsigned long lastRArmMove = 0;
unsigned long lastFArmMove = 0;
unsigned long lastClawMove = 0;


// ============================================================
//                    11. 初始化
// ============================================================

void setup()
{
