int rArmTarget = 90;
int fArmTarget = 90;
int clawTarget = 90;


// ============================================================
//                    7. 自动运动状态
// ============================================================

// true：正在执行串口自动运动
// false：没有自动运动

bool autoMoving = false;


// ============================================================
//                    8. 摇杆参数
// ============================================================

// Arduino 模拟输入范围：0~1023
// 摇杆中心通常约为 512

const int JOY_CENTER = 512;


// 摇杆死区
