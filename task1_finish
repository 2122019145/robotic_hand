// ============================================================
//              12. 判断某个摇杆是否被推动
// ============================================================

bool joystickMoved(int joystickValue)
{
    int difference = joystickValue - JOY_CENTER;

    if (abs(difference) >= DEAD_ZONE)
    {
        return true;
    }

    return false;
}


// ============================================================
//              13. 摇杆控制一个舵机
// ============================================================
//
// 这个函数与以前最大的区别：
//
// 摇杆控制时，直接修改“当前角度”。
// 不会重新计算一个固定目标。
//
// 所以松开摇杆以后：
//
// 舵机停在哪里，就停在哪里。
//
// ============================================================

void controlJoystickServo(
    int joystickValue,
    int &servoAngle,
    Servo &servo,
    int minAngle,
    int maxAngle,
    unsigned long &lastMove,
    bool reverseDirection
)
{
    unsigned long currentTime = millis();


    // -------------------------
    // 判断是否到了下一次运动时间
    // -------------------------

    if (currentTime - lastMove < moveInterval)
    {
        return;
    }


    // -------------------------
    // 计算摇杆偏移量
    // -------------------------

    int difference = joystickValue - JOY_CENTER;


    // -------------------------
    // 死区
    // -------------------------

    if (abs(difference) < DEAD_ZONE)
    {
        return;
    }


    // -------------------------
    // 根据摇杆方向改变角度
    // -------------------------

  if (difference > 0)
{
    if (reverseDirection)
        servoAngle--;
    else
        servoAngle++;
}
else
{
    if (reverseDirection)
        servoAngle++;
    else
        servoAngle--;
}


    // -------------------------
    // 限制角度
    // -------------------------

    servoAngle = constrain(
        servoAngle,
        minAngle,
        maxAngle
    );


    // -------------------------
    // 输出舵机
    // -------------------------

    servo.write(servoAngle);


    // -------------------------
    // 记录时间
    // -------------------------

    lastMove = currentTime;
}


// ============================================================
//              14. 摇杆控制系统
// ============================================================

void joystickControl()
{
    // -------------------------
    // 读取四个摇杆
    // -------------------------

    int baseJoy = analogRead(JOY_BASE);
    int rArmJoy = analogRead(JOY_RARM);
    int fArmJoy = analogRead(JOY_FARM);
    int clawJoy = analogRead(JOY_CLAW);


    // -------------------------
    // 判断是否有人正在操作摇杆
    // -------------------------

    bool joystickIsMoving =
        joystickMoved(baseJoy) ||
        joystickMoved(rArmJoy) ||
        joystickMoved(fArmJoy) ||
        joystickMoved(clawJoy);


    // -------------------------
    // 如果摇杆被操作
    //
    // 说明人工操作优先。
    //
    // 取消正在执行的自动运动。
    // -------------------------

    if (joystickIsMoving)
    {
        autoMoving = false;


        // 非常重要：
        //
        // 自动运动被取消以后，
        // 目标角度必须同步到当前角度。
        //
        // 否则松开摇杆后，
        // 自动运动可能又把舵机拉回去。

        baseTarget = baseAngle;
        rArmTarget = rArmAngle;
        fArmTarget = fArmAngle;
        clawTarget = clawAngle;
    }


    // -------------------------
    // 控制四个舵机
    // -------------------------

// 底座：方向反转
controlJoystickServo(
    baseJoy,
    baseAngle,
    base,
    BASE_MIN,
    BASE_MAX,
    lastBaseMove,
    true
);


// 大臂：正常
controlJoystickServo(
    rArmJoy,
    rArmAngle,
    rArm,
    RARM_MIN,
    RARM_MAX,
    lastRArmMove,
    false
);


// 小臂：方向反转
controlJoystickServo(
    fArmJoy,
    fArmAngle,
    fArm,
    FARM_MIN,
    FARM_MAX,
    lastFArmMove,
    true
);


// 爪子：正常
controlJoystickServo(
    clawJoy,
    clawAngle,
    claw,
    CLAW_MIN,
    CLAW_MAX,
    lastClawMove,
    false
);
}


// ============================================================
//              15. 自动移动一个舵机
// ============================================================

void moveServoToTarget(
    int &currentAngle,
    int targetAngle,
    Servo &servo,
    unsigned long &lastMove
)
{
    unsigned long currentTime = millis();


    // -------------------------
    // 判断运动时间
    // -------------------------

    if (currentTime - lastMove < moveInterval)
    {
        return;
    }


    // -------------------------
    // 如果已经到目标
    // -------------------------

    if (currentAngle == targetAngle)
    {
        return;
    }


    // -------------------------
    // 向目标靠近 1°
    // -------------------------

    if (currentAngle < targetAngle)
    {
        currentAngle++;
    }
    else
    {
        currentAngle--;
    }


    // -------------------------
    // 输出
    // -------------------------

    servo.write(currentAngle);


    // -------------------------
    // 记录时间
    // -------------------------

    lastMove = currentTime;
}


// ============================================================
//              16. 自动运动系统
// ============================================================

void updateAutoMovement()
{
    // 如果没有自动运动
    // 直接退出

    if (!autoMoving)
    {
        return;
    }


    // -------------------------
    // 四个舵机分别向目标移动
    // -------------------------

    moveServoToTarget(
        baseAngle,
        baseTarget,
        base,
        lastBaseMove
    );


    moveServoToTarget(
        rArmAngle,
        rArmTarget,
        rArm,
        lastRArmMove
    );


    moveServoToTarget(
        fArmAngle,
        fArmTarget,
        fArm,
        lastFArmMove
    );


    moveServoToTarget(
        clawAngle,
        clawTarget,
        claw,
        lastClawMove
    );


    // -------------------------
    // 判断是否全部到达
    // -------------------------

    if (
        baseAngle == baseTarget &&
        rArmAngle == rArmTarget &&
        fArmAngle == fArmTarget &&
        clawAngle == clawTarget
    )
    {
        autoMoving = false;

        Serial.println("自动运动完成");
    }
}


// ============================================================
//                    17. 张开爪子
// ============================================================
void openClaw()
{
    clawTarget = CLAW_MIN;
    autoMoving = true;

    Serial.println("爪子：张开");
}


// ============================================================
//                    18. 关闭爪子
// ============================================================
void closeClaw()
{
    clawTarget = CLAW_MAX;
    autoMoving = true;

    Serial.println("爪子：关闭");
}



// ============================================================
//                    19. 加快速度
// ============================================================

void increaseSpeed()
{
    moveInterval -= 10;


    if (moveInterval < FASTEST)
    {
        moveInterval = FASTEST;
    }


    Serial.print("速度提高，当前间隔：");
    Serial.print(moveInterval);
    Serial.println(" ms");
}


// ============================================================
//                    20. 降低速度
// ============================================================

void decreaseSpeed()
{
    moveInterval += 10;


    if (moveInterval > SLOWEST)
    {
        moveInterval = SLOWEST;
    }


    Serial.print("速度降低，当前间隔：");
    Serial.print(moveInterval);
    Serial.println(" ms");
}


// ============================================================
//              21. 多舵机协同控制
// ============================================================
//
// 指令格式：
//
// x120,y80,z100
//
// 我们规定：
//
// x → base
// y → rArm
// z → fArm
//
// 注意：
// 这里的数字是“绝对角度”
//
// 例如：
//
// x120,y80,z100
//
// 表示：
// 底座 → 120°
// 大臂 → 80°
// 小臂 → 100°
//
// ============================================================

void multiServoControl(String command)
{
    // -------------------------
    // 找到 x y z
    // -------------------------

    int xIndex = command.indexOf('x');
    int yIndex = command.indexOf('y');
    int zIndex = command.indexOf('z');


    // 同时兼容大写 X Y Z

    if (xIndex == -1)
    {
        xIndex = command.indexOf('X');
    }

    if (yIndex == -1)
    {
        yIndex = command.indexOf('Y');
    }

    if (zIndex == -1)
    {
        zIndex = command.indexOf('Z');
    }


    // -------------------------
    // 找逗号
    // -------------------------

    int comma1 = command.indexOf(',');
    int comma2 = command.indexOf(',', comma1 + 1);


    // -------------------------
    // 检查格式
    // -------------------------

    if (
        xIndex == -1 ||
        yIndex == -1 ||
        zIndex == -1 ||
        comma1 == -1 ||
        comma2 == -1
    )
    {
        Serial.println("指令格式错误！");
        Serial.println("正确格式：x120,y80,z100");

        return;
    }


    // -------------------------
    // 解析 x
    // -------------------------

    int xAngle = command.substring(
        xIndex + 1,
        comma1
    ).toInt();


    // -------------------------
    // 解析 y
    // -------------------------

    int yAngle = command.substring(
        yIndex + 1,
        comma2
    ).toInt();


    // -------------------------
    // 解析 z
    // -------------------------

    int zAngle = command.substring(
        zIndex + 1
    ).toInt();


    // -------------------------
    // 限制角度
    // -------------------------

    xAngle = constrain(
        xAngle,
        BASE_MIN,
        BASE_MAX
    );


    yAngle = constrain(
        yAngle,
        RARM_MIN,
        RARM_MAX
    );


    zAngle = constrain(
        zAngle,
        FARM_MIN,
        FARM_MAX
    );


    // -------------------------
    // 设置目标角度
    // -------------------------

    baseTarget = xAngle;
    rArmTarget = yAngle;
    fArmTarget = zAngle;


    // -------------------------
    // 开启自动运动
    // -------------------------

    autoMoving = true;


    // -------------------------
    // 输出信息
    // -------------------------

    Serial.println("收到多舵机目标：");

    Serial.print("Base = ");
    Serial.println(baseTarget);

    Serial.print("rArm = ");
    Serial.println(rArmTarget);

    Serial.print("fArm = ");
    Serial.println(fArmTarget);
}


// ============================================================
//                    22. 串口控制
// ============================================================

void serialControl()
{
    if (Serial.available() <= 0)
    {
        return;
    }


    // -------------------------
    // 读取一整行
    // -------------------------

    String command = Serial.readStringUntil('\n');

    command.trim();


    // -------------------------
    // 空指令
    // -------------------------

    if (command.length() == 0)
    {
        return;
    }


    // ========================================================
    // 固定指令
    // ========================================================

    if (command == "O" || command == "o")
    {
        openClaw();
    }


    else if (command == "S" || command == "s")
    {
        closeClaw();
    }


    else if (command == "H" || command == "h")
    {
        increaseSpeed();
    }


    else if (command == "L" || command == "l")
    {
        decreaseSpeed();
    }


    // ========================================================
    // 多舵机指令
    // ========================================================

    else if (
        command.indexOf('x') != -1 ||
        command.indexOf('X') != -1
    )
    {
        multiServoControl(command);
    }


    // ========================================================
    // 未知指令
    // ========================================================

    else
    {
        Serial.print("未知指令：");
        Serial.println(command);
    }
}


